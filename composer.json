{
    "name": "sage-grids/laravel-site-settings",
    "description": "Reusable site settings and brand settings for Laravel applications using Spatie Laravel Settings",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "settings",
        "site-settings",
        "brand-settings",
        "spatie"
    ],
    "authors": [
        {
            "name": "Ilyas Serter",
            "homepage": "https://www.iserter.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "SageGrids\\SiteSettings\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SageGrids\\SiteSettings\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SageGrids\\SiteSettings\\SiteSettingsServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "spatie/laravel-settings": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
